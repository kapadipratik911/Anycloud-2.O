# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database Configuration
# For local development with SQLite:
# DATABASE_URL="file:./dev.db"

# For Supabase (PostgreSQL):
# Get your connection string from Supabase Dashboard > Settings > Database
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.vtczrvskyjizdvycawid.supabase.co:5432/postgres"

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE=10737418240
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,bmp,webp,svg,pdf,txt,doc,docx,xls,xlsx,ppt,pptx,csv,rtf,odt,ods,odp,zip,rar,7z,tar,gz,mp4,mov,avi,mkv,webm,flv,wmv,mp3,wav,ogg,flac,aac,m4a,js,ts,html,css,json,py,java,cpp,c,php,rb,go,md
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ANY CLOUD 2.0 <noreply@localhost>
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend Environment Variables
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=
