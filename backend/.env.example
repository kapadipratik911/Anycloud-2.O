# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (Generate a secure random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10737418240
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf,txt,zip,mp4,doc,docx,xls,xlsx,ppt,pptx

# CORS
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google Sign-In (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Optional SMTP for forgot-password emails. In development the reset
# link is also returned in the API response when SMTP is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ANY CLOUD 2.0 <noreply@localhost>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
